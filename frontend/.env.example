# Base URL the browser uses to reach the Saraha backend.
# "/api" (default) goes through the Vite dev/preview proxy. For production, route /api (stripping the prefix),
# /socket.io, and /uploads to the backend, or set an absolute API URL and allow the frontend origin
# in backend FRONTEND_ORIGIN. Optional direct Socket.IO origin; empty uses same-origin proxy.
VITE_API_BASE_URL=/api

# Where the dev/preview proxy forwards "/api" to (the backend's PORT from its .env).
VITE_DEV_PROXY_TARGET=http://localhost:5000

VITE_SOCKET_URL=
